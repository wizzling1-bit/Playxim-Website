rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // User Profile Documents - Public read for creator profiles, authenticated write
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Unique Username Reservation Map
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Creator Folders
    match /folders/{folderId} {
      allow read, write: if isAuthenticated();
    }

    // Content Metadata - Public read for shared items, authenticated write
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Playlists
    match /playlists/{playlistId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Public / Password Share Links
    match /share_links/{code} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Telemetry Events
    match /analytics_events/{eventId} {
      allow read, write: if true;
    }

    // Daily Analytics Aggregates
    match /analytics_daily/{dailyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Creator Earnings Ledger
    match /earnings_ledger/{txId} {
      allow read, write: if isAuthenticated();
    }

    // Creator Balances
    match /creator_balances/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Payout Requests
    match /payout_requests/{reqId} {
      allow read, write: if isAuthenticated();
    }

    // Platform Settings
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
